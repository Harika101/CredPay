FROM node:18-alpine AS build
WORKDIR /build
COPY package*json./
RUN npm install
COPY . .
RUN npmn run build 
FROM nginx:stable-alpine
copy nginx.conf/etc/nginx/conf.d/default.conf
copy --from=buil/build/dist/usr/share/nginx/html
EXPOSE 8080
ENTRYPOINT["uvicorn","app.main:app", "--host","0.0.0.0","--port","8080"]


